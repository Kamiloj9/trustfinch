ca_fqdn             = "ca-euw1.example.internal"
internal_dns_suffix = "example.internal"
trust_domain        = "example.internal"
runtime_release_id  = "2026-07-30.1"
availability_zones  = ["eu-west-1a", "eu-west-1b"]
allowed_https_cidrs = ["203.0.113.0/24"]
acm_certificate_arn = "arn:aws:acm:eu-west-1:111122223333:certificate/replace-me"
# WAF blocks a source IP after 500 requests in five minutes. Tune this only
# after measuring expected client-NAT and enrollment bursts.
enable_waf_rate_limit = true
waf_rate_limit        = 500
# Maximum intermediate-KMS signing requests over five minutes before an
# issuance-abuse/cost alarm. Tune after measuring expected enrollment bursts.
intermediate_kms_sign_alarm_threshold = 500

key_administrator_arns          = ["arn:aws:iam::111122223333:role/pki-key-administrator"]
intermediate_ceremony_role_arns = ["arn:aws:iam::111122223333:role/pki-intermediate-ceremony"]
certificate_publisher_role_arns = ["arn:aws:iam::111122223333:role/pki-root-ceremony"]

# Configure these identically to the primary region when issuer failover is required.
# google_oidc = {
#   client_id         = "replace.apps.googleusercontent.com"
#   workspace_domain  = "example.com"
#   client_secret_arn = "arn:aws:secretsmanager:eu-west-1:111122223333:secret:pki/google-oidc"
# }
# Use a region-specific audience and replay table. Do not reuse the EU Central
# broker JWK or audience in this independent regional issuance path.
# gitlab_oidc = {
#   issuer                = "https://gitlab.com"
#   broker_image          = "111122223333.dkr.ecr.eu-west-1.amazonaws.com/pki-gitlab-broker@sha256:replace-with-64-hex-digest"
#   broker_jwk_secret_arn = "arn:aws:secretsmanager:eu-west-1:111122223333:secret:pki/gitlab-broker-jwk"
#   broker_jwk_public     = { kty = "EC", crv = "P-256", x = "replace", y = "replace", kid = "gitlab-broker-euw1-2026-07" }
#   identities = [{
#     project_id = "12345", project_path = "platform/pki", audience = "https://ca-euw1.example.internal/gitlab/platform-pki"
#     ref_type = "branch", ref = "main", subject = "gitlab:platform/pki", uri_san = "spiffe://example.internal/gitlab/platform/pki"
#   }]
# }
# Optional: GitLab CI deploys through short-lived AWS STS credentials only.
# Define the named policies and permission boundary in the account baseline;
# they must be customer-managed and scoped to this environment. Protect main
# and the named deployment tag in GitLab before enabling these roles. GitLab.com
# supports project_id and ref_protected as IAM condition keys; omit unsupported
# claims for self-managed GitLab, but retain the exact subject and audience.
# gitlab_terraform_deployment = {
#   oidc_provider_arn        = "arn:aws:iam::111122223333:oidc-provider/gitlab.com"
#   oidc_provider_url        = "https://gitlab.com"
#   audience                 = "sts.amazonaws.com"
#   plan_subjects            = ["project_path:platform/pki:ref_type:branch:ref:main"]
#   apply_subjects           = ["project_path:platform/pki:ref_type:tag:ref:deploy-prod-euw1"]
#   plan_additional_claims   = { project_id = ["12345"], ref_protected = ["true"] }
#   apply_additional_claims  = { project_id = ["12345"], ref_protected = ["true"] }
#   plan_policy_arns         = ["arn:aws:iam::111122223333:policy/pki-prod-euw1-terraform-plan"]
#   apply_policy_arns        = ["arn:aws:iam::111122223333:policy/pki-prod-euw1-terraform-apply"]
#   permissions_boundary_arn = "arn:aws:iam::111122223333:policy/pki-terraform-boundary"
# }

# Required before production traffic: use a distinct regional KMS key to sign
# the complete runtime S3 payload. Bootstrap with verification_enabled = false,
# sign it with ceremony/sign-runtime-artifacts.sh and the emitted key ID, then
# set verification_enabled = true in a separate reviewed rollout.
# runtime_artifact_signing = {
#   key_administrator_arns    = ["arn:aws:iam::111122223333:role/pki-artifact-key-administrator"]
#   artifact_signer_role_arns = ["arn:aws:iam::111122223333:role/pki-runtime-release-signer"]
#   verification_enabled      = false
#   image_verification_enabled = false
# }

# Required if image_verification_enabled is true: use signed digest-pinned
# images mirrored to a registry reachable by the runtime nodes.
# runtime_images = {
#   step_ca_image       = "111122223333.dkr.ecr.eu-west-1.amazonaws.com/pki-step-ca@sha256:<digest>"
#   caddy_image         = "111122223333.dkr.ecr.eu-west-1.amazonaws.com/pki-caddy@sha256:<digest>"
#   ecr_registry        = "111122223333.dkr.ecr.eu-west-1.amazonaws.com"
#   ecr_repository_arns = [
#     "arn:aws:ecr:eu-west-1:111122223333:repository/pki-step-ca",
#     "arn:aws:ecr:eu-west-1:111122223333:repository/pki-caddy",
#   ]
# }

# Keep the IAM broker key and Lambda image region-specific. API Gateway accepts
# only SigV4 requests from a role with the emitted exact invoke policy.
# iam_sigv4 = {
#   lambda_image                = "111122223333.dkr.ecr.eu-west-1.amazonaws.com/pki-iam-broker@sha256:replace-with-64-hex-digest"
#   broker_jwk_secret_arn       = "arn:aws:secretsmanager:eu-west-1:111122223333:secret:pki/iam-broker-jwk"
#   ca_tls_root_certificate_pem = ""
#   broker_jwk_public           = { kty = "EC", crv = "P-256", x = "replace", y = "replace", kid = "iam-broker-euw1-2026-07" }
#   identities = [{
#     role_arn = "arn:aws:iam::111122223333:role/platform-pki-runner", subject = "iam:platform/pki-runner", uri_san = "spiffe://example.internal/iam/platform/pki-runner"
#   }]
# }
# aws_iid_accounts      = ["111122223333"]
