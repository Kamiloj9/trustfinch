# Never put long-lived AWS access keys or JWK/provisioner secrets in this file.
key_administrator_arns = ["arn:aws:iam::111122223333:role/pki-key-administrator"]
root_ceremony_role_arns = ["arn:aws:iam::111122223333:role/pki-root-ceremony"]
certificate_publisher_role_arns = ["arn:aws:iam::111122223333:role/pki-root-ceremony"]

ca_fqdn             = "ca.dev.example.internal"
internal_dns_suffix = "dev.example.internal"
trust_domain        = "dev.example.internal"
allowed_https_cidrs = ["203.0.113.0/24"]
# Maximum intermediate-KMS signing requests over five minutes before an
# issuance-abuse/cost alarm. Tune after measuring expected enrollment bursts.
intermediate_kms_sign_alarm_threshold = 200

# Daily recovery points for the encrypted Lean step-ca state volume. Keep this
# at or above the agreed RPO window and rehearse the recovery runbook.
backup_retention_days = 35

# Optional: secret JSON must have a client_secret field.
# google_oidc = {
#   client_id         = "replace.apps.googleusercontent.com"
#   workspace_domain  = "example.com"
#   client_secret_arn = "arn:aws:secretsmanager:eu-central-1:111122223333:secret:pki/google-oidc"
# }
# Optional: the secret value is a raw private P-256 JWK. Build and publish the
# broker image first; use an immutable digest. Every allowed protected ref gets
# an explicit, fixed SPIFFE identity and GitLab ID-token audience.
# gitlab_oidc = {
#   issuer                = "https://gitlab.com"
#   broker_image          = "111122223333.dkr.ecr.eu-central-1.amazonaws.com/pki-gitlab-broker@sha256:replace-with-64-hex-digest"
#   broker_jwk_secret_arn = "arn:aws:secretsmanager:eu-central-1:111122223333:secret:pki/gitlab-broker-jwk"
#   broker_jwk_public     = { kty = "EC", crv = "P-256", x = "replace", y = "replace", kid = "gitlab-broker-2026-07" }
#   identities = [{
#     project_id = "12345", project_path = "platform/pki", audience = "https://ca.dev.example.internal/gitlab/platform-pki"
#     ref_type = "branch", ref = "main", subject = "gitlab:platform/pki", uri_san = "spiffe://dev.example.internal/gitlab/platform/pki"
#   }]
# }
# Optional: GitLab CI deploys through short-lived AWS STS credentials only.
# Define the named policies and permission boundary in the account baseline;
# they must be customer-managed and scoped to this environment. Protect main
# and the named deployment tag in GitLab before enabling these roles. GitLab.com
# supports project_id and ref_protected as IAM condition keys; omit unsupported
# claims for self-managed GitLab, but retain the exact subject and audience.
# gitlab_terraform_deployment = {
#   oidc_provider_arn        = "arn:aws:iam::111122223333:oidc-provider/gitlab.com"
#   oidc_provider_url        = "https://gitlab.com"
#   audience                 = "sts.amazonaws.com"
#   plan_subjects            = ["project_path:platform/pki:ref_type:branch:ref:main"]
#   apply_subjects           = ["project_path:platform/pki:ref_type:tag:ref:deploy-dev"]
#   plan_additional_claims   = { project_id = ["12345"], ref_protected = ["true"] }
#   apply_additional_claims  = { project_id = ["12345"], ref_protected = ["true"] }
#   plan_policy_arns         = ["arn:aws:iam::111122223333:policy/pki-dev-terraform-plan"]
#   apply_policy_arns        = ["arn:aws:iam::111122223333:policy/pki-dev-terraform-apply"]
#   permissions_boundary_arn = "arn:aws:iam::111122223333:policy/pki-terraform-boundary"
# }

# Optional: use a distinct KMS key to sign the complete runtime S3 payload.
# Bootstrap with verification_enabled = false, use the emitted key ID with
# ceremony/sign-runtime-artifacts.sh, then turn it true in a second reviewed
# apply. The signer must never be the EC2 runtime role or a CA ceremony role.
# runtime_artifact_signing = {
#   key_administrator_arns    = ["arn:aws:iam::111122223333:role/pki-artifact-key-administrator"]
#   artifact_signer_role_arns = ["arn:aws:iam::111122223333:role/pki-runtime-release-signer"]
#   verification_enabled      = false
# }

# Optional: API Gateway verifies SigV4 before Lambda receives the trusted IAM
# context. Build broker/iam-lambda.Dockerfile for linux/arm64, publish it to
# ECR by immutable digest, and attach the emitted invoke-policy output only to
# the reviewed role below. Leave ca_tls_root_certificate_pem empty when the CA
# endpoint uses a public Web-PKI certificate.
# iam_sigv4 = {
#   lambda_image                = "111122223333.dkr.ecr.eu-central-1.amazonaws.com/pki-iam-broker@sha256:replace-with-64-hex-digest"
#   broker_jwk_secret_arn       = "arn:aws:secretsmanager:eu-central-1:111122223333:secret:pki/iam-broker-jwk"
#   ca_tls_root_certificate_pem = ""
#   broker_jwk_public           = { kty = "EC", crv = "P-256", x = "replace", y = "replace", kid = "iam-broker-2026-07" }
#   identities = [{
#     role_arn = "arn:aws:iam::111122223333:role/platform-pki-runner", subject = "iam:platform/pki-runner", uri_san = "spiffe://dev.example.internal/iam/platform/pki-runner"
#   }]
# }
# aws_iid_accounts      = ["111122223333"]
# aws_iid_dns_allowlist = ["*.eu-central-1.compute.internal"]
# Optional: ACME accepts only proof-of-possession challenges for DNS names in
# these reviewed wildcard subdomains. Keep an independent DNS or network
# challenge-ownership control for every client that uses this provisioner.
# acme = {
#   dns_allowlist = ["*.apps.dev.example.internal"]
# }

# Keep false except for the tightly timed root certificate ceremony.
root_key_enabled = false
