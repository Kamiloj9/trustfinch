#!/bin/bash
set -euo pipefail

# Reviewed runtime artifact release: ${runtime_release_id}
dnf install -y docker awscli2 python3 gettext openssl findutils amazon-cloudwatch-agent
install -d -m 0755 /usr/local/lib/docker/cli-plugins
curl --fail --silent --show-error --location \
  --output /usr/local/lib/docker/cli-plugins/docker-compose \
  https://github.com/docker/compose/releases/download/v5.3.1/docker-compose-linux-aarch64
echo 'aa611e811d0ea25897839c404bfb5bf93ce706dc51c500a4457890f5d0606a86  /usr/local/lib/docker/cli-plugins/docker-compose' | sha256sum -c -
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version
systemctl enable --now docker

install -d -m 0755 /opt/aws/amazon-cloudwatch-agent/etc
cat >/opt/aws/amazon-cloudwatch-agent/etc/pki-host-metrics.json <<'JSON'
{
  "agent": {
    "metrics_collection_interval": 60
  },
  "metrics": {
    "namespace": "PKI/Host",
    "aggregation_dimensions": [["PKIName"]],
    "metrics_collected": {
      "disk": {
        "resources": ["/"],
        "measurement": ["used_percent"],
        "metrics_collection_interval": 60,
        "ignore_file_system_types": ["sysfs", "devtmpfs", "tmpfs", "overlay", "squashfs"],
        "append_dimensions": {
          "PKIName": "${pki_name}"
        }
      }
    }
  }
}
JSON
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/pki-host-metrics.json
systemctl enable amazon-cloudwatch-agent
install -d -m 0750 /opt/pki/runtime

%{ if artifact_verification_enabled }
install -d -m 0755 /usr/local/libexec /etc/pki/pki-runtime
cat >/usr/local/libexec/pki-verify-runtime-artifacts <<'VERIFY_RUNTIME_ARTIFACTS'
${artifact_verifier_script}
VERIFY_RUNTIME_ARTIFACTS
chmod 0755 /usr/local/libexec/pki-verify-runtime-artifacts
cat >/etc/pki/pki-runtime/artifact-signing-public.pem <<'ARTIFACT_SIGNING_PUBLIC_KEY'
${artifact_signing_public_key_pem}
ARTIFACT_SIGNING_PUBLIC_KEY
chmod 0644 /etc/pki/pki-runtime/artifact-signing-public.pem
%{ endif }
%{ if container_image_verification_enabled }
install -d -m 0755 /usr/local/libexec /etc/pki/pki-runtime
cat >/usr/local/libexec/pki-verify-container-images <<'VERIFY_CONTAINER_IMAGES'
${container_image_verifier_script}
VERIFY_CONTAINER_IMAGES
chmod 0755 /usr/local/libexec/pki-verify-container-images
cat >/etc/pki/pki-runtime/container-image-signing-public.pem <<'CONTAINER_IMAGE_SIGNING_PUBLIC_KEY'
${container_image_signing_public_key_pem}
CONTAINER_IMAGE_SIGNING_PUBLIC_KEY
chmod 0644 /etc/pki/pki-runtime/container-image-signing-public.pem
%{ endif }

cat >/etc/systemd/system/pki-runtime.service <<'UNIT'
[Unit]
Description=HA self-hosted PKI runtime
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=on-failure
RestartSec=30
TimeoutStartSec=0
ExecStartPre=/usr/bin/mkdir -p /opt/pki/runtime
ExecStartPre=/usr/bin/aws s3 sync s3://${artifact_bucket}/runtime /opt/pki/runtime --exact-timestamps
%{ if artifact_verification_enabled }
ExecStartPre=/usr/local/libexec/pki-verify-runtime-artifacts --runtime-dir /opt/pki/runtime --public-key /etc/pki/pki-runtime/artifact-signing-public.pem
%{ endif }
%{ if container_image_ecr_registry != "" }
ExecStartPre=/usr/bin/bash -c '/usr/bin/aws ecr get-login-password --region ${aws_region} | /usr/bin/docker login --username AWS --password-stdin ${container_image_ecr_registry}'
%{ endif }
%{ if container_image_verification_enabled }
ExecStartPre=/usr/local/libexec/pki-verify-container-images --compose-file /opt/pki/runtime/step-ca-ha-compose.yml --public-key /etc/pki/pki-runtime/container-image-signing-public.pem
%{ endif }
ExecStartPre=/usr/bin/curl --fail --silent --show-error --location --output /opt/pki/runtime/rds-ca-bundle.pem https://truststore.pki.rds.amazonaws.com/${aws_region}/${aws_region}-bundle.pem
ExecStartPre=/usr/bin/bash -c 'secret_arn="${google_oidc_client_secret_arn}"; if [[ -n "$secret_arn" ]]; then GOOGLE_OIDC_CLIENT_SECRET="$(/usr/bin/aws secretsmanager get-secret-value --secret-id "$secret_arn" --query SecretString --output text | /usr/bin/python3 -c "import json,sys; print(json.load(sys.stdin)[\"client_secret\"], end=\"\")")" /usr/bin/envsubst < /opt/pki/runtime/step-ca/ca.json > /opt/pki/runtime/step-ca/rendered-ca.json; else cp /opt/pki/runtime/step-ca/ca.json /opt/pki/runtime/step-ca/rendered-ca.json; fi; chown 1000:1000 /opt/pki/runtime/step-ca/rendered-ca.json; chmod 0600 /opt/pki/runtime/step-ca/rendered-ca.json'
ExecStartPre=/usr/bin/rm -f /opt/pki/runtime/secrets/gitlab-broker.jwk
ExecStartPre=/usr/bin/bash -c 'secret_arn="${gitlab_broker_jwk_secret_arn}"; if [[ -n "$secret_arn" ]]; then /usr/bin/install -d -m 0700 /opt/pki/runtime/secrets && /usr/bin/aws secretsmanager get-secret-value --secret-id "$secret_arn" --query SecretString --output text > /opt/pki/runtime/secrets/gitlab-broker.jwk && /usr/bin/chown 65532:65532 /opt/pki/runtime/secrets/gitlab-broker.jwk && /usr/bin/chmod 0400 /opt/pki/runtime/secrets/gitlab-broker.jwk; fi'
ExecStartPre=/usr/bin/bash -c '/usr/bin/aws secretsmanager get-secret-value --secret-id ${database_secret_arn} --query SecretString --output text | /usr/bin/python3 -c "import json,sys; print(\"STEP_CA_DB_PASSWORD=\" + json.dumps(json.load(sys.stdin)[\"password\"]))" > /opt/pki/runtime/.env && chmod 0600 /opt/pki/runtime/.env'
ExecStart=/usr/bin/docker compose --env-file /opt/pki/runtime/.env -f /opt/pki/runtime/step-ca-ha-compose.yml up --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /opt/pki/runtime/.env -f /opt/pki/runtime/step-ca-ha-compose.yml down

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now pki-runtime.service
