# Install as /etc/pki/renewal.env with mode 0600. The key itself must be
# readable only by the workload account that runs the systemd service.
PKI_CERTIFICATE_PATH=/etc/workload/tls.crt
PKI_PRIVATE_KEY_PATH=/etc/workload/tls.key
PKI_ROOT_CERTIFICATE_PATH=/etc/pki/root_ca.crt
PKI_CA_URL=https://ca.example.internal

# The one-hour timer checks frequently, but renewal occurs only after this
# window. `step ca renew` adds its own small random jitter to this threshold.
PKI_RENEW_EXPIRES_IN=8h
# Leave false in service use. It is useful only for a controlled immediate
# renewal test because it bypasses the normal expiry window.
PKI_RENEW_FORCE_NOW=false
PKI_RENEW_MAX_ATTEMPTS=5
PKI_RENEW_BACKOFF_INITIAL_SECONDS=5
PKI_RENEW_BACKOFF_MAX_SECONDS=300

# Optional: run only after a verified certificate is atomically installed.
# PKI_RELOAD_COMMAND=systemctl reload workload.service
