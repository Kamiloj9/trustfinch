services:
  step-ca:
    image: ${step_ca_image}
    entrypoint: ["/usr/bin/env", "bash", "/usr/local/bin/pki-step-ca-entrypoint"]
    command: ["/home/step/config/ca.json"]
    restart: unless-stopped
    environment:
      AWS_REGION: ${aws_region}
      AWS_DEFAULT_REGION: ${aws_region}
      PGHOST: ${database_endpoint}
      PGPORT: "${database_port}"
      PGDATABASE: ${database_name}
      PGUSER: ${database_username}
      PGPASSWORD: "$${STEP_CA_DB_PASSWORD}"
      PGSSLMODE: verify-full
      PGSSLROOTCERT: /etc/ssl/certs/rds-ca-bundle.pem
    read_only: true
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:mode=1777,noexec,nosuid,size=64m
    volumes:
      - /opt/pki/runtime/step-ca/rendered-ca.json:/home/step/config/ca.json:ro
      - /opt/pki/runtime/step-ca/step-ca-entrypoint.sh:/usr/local/bin/pki-step-ca-entrypoint:ro
      - /opt/pki/runtime/step-ca/redact-step-ca-logs.sh:/usr/local/bin/pki-redact-step-ca-logs:ro
      - /opt/pki/runtime/certs:/etc/step-ca/certs:ro
      - /opt/pki/runtime/templates:/home/step/templates:ro
      - /opt/pki/runtime/rds-ca-bundle.pem:/etc/ssl/certs/rds-ca-bundle.pem:ro
    expose:
      - "9000"
    networks:
      default:
        aliases:
          - ${ca_fqdn}
    logging:
      driver: awslogs
      options:
        awslogs-region: ${aws_region}
        awslogs-group: ${cloudwatch_log_group}
        awslogs-stream: step-ca

%{ if gitlab_broker_enabled ~}
  gitlab-enrollment-broker:
    image: ${gitlab_broker_image}
    restart: unless-stopped
    read_only: true
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:mode=1777,noexec,nosuid,size=32m
    ports:
      - "8080:8080"
    environment:
      AWS_REGION: ${aws_region}
      AWS_DEFAULT_REGION: ${aws_region}
      BROKER_CONFIG: /etc/gitlab-enrollment-broker/config.json
      BROKER_JWK_PATH: /run/secrets/gitlab-broker.jwk
      BROKER_CA_ROOT_PATH: /etc/step-ca/certs/root_ca.crt
      BROKER_REPLAY_STORE: dynamodb
    volumes:
      - /opt/pki/runtime/gitlab-broker/config.json:/etc/gitlab-enrollment-broker/config.json:ro
      - /opt/pki/runtime/secrets/gitlab-broker.jwk:/run/secrets/gitlab-broker.jwk:ro
      - /opt/pki/runtime/certs/root_ca.crt:/etc/step-ca/certs/root_ca.crt:ro
    depends_on:
      - step-ca
    logging:
      driver: awslogs
      options:
        awslogs-region: ${aws_region}
        awslogs-group: ${cloudwatch_log_group}
        awslogs-stream: gitlab-enrollment-broker
%{ endif ~}
